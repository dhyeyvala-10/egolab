# Base URL of the Ego Labs FastAPI service, used by the Next.js server (no trailing slash).
API_URL=http://localhost:8000
# Set to true when the web app is served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
# The web app's address as browsers see it, if requests arrive on another one (e.g. behind a proxy).
# Google redirects back to <this>/auth/google/callback, which must be listed in the OAuth client.
PUBLIC_WEB_URL=
