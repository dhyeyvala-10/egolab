# Optional overrides for `docker compose up`. Copy to .env and edit; every value has a dev default.
POSTGRES_USER=egolabs
POSTGRES_PASSWORD=egolabs
POSTGRES_DB=egolabs
MINIO_ROOT_USER=egolabs
MINIO_ROOT_PASSWORD=egolabs-dev-secret
# Required outside development: a random string of at least 32 characters.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
ENVIRONMENT=development
# Sign-in with Google (the only way people sign in). In Google Cloud Console: APIs & Services →
# Credentials → Create credentials → OAuth client ID → Web application, and add the authorised redirect
# URI http://localhost:3000/auth/google/callback (or your web address + /auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The admins' Google emails, separated by commas (one is fine). They can't be changed from the app; everyone
# else who signs in starts with no access until an admin gives them a role (Settings → Users). Empty: the
# first account to sign in is the only admin (fine on your own machine, required online).
OWNER_EMAIL=
# The web app's address as browsers see it, when it isn't the one requests arrive on (behind a proxy).
PUBLIC_WEB_URL=
# Email and password sign-in through the API, for scripts only (make seed, the smoke test). Never shown
# on the login page; leave off unless a script needs it.
PASSWORD_LOGIN=false
LOG_LEVEL=INFO
# Inspector proxy codec: h264 (default) or vp9 for browsers built without H.264
PROXY_CODEC=h264
# Host ports
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Online (docker-compose.prod.yml, scripts/deploy.ps1, docs/deploy.md): the addresses people use and the
# Cloudflare Tunnel's token. Leave empty for local use.
APP_DOMAIN=
FILES_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=
# How the tunnel connects: http2 (default, fastest on most home connections) or quic.
CLOUDFLARE_TUNNEL_PROTOCOL=http2
