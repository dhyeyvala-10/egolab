# Copy to .env for running the API or worker outside Docker.
DATABASE_URL=postgresql+psycopg://egolabs:egolabs@localhost:5432/egolabs
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=egolabs
S3_SECRET_KEY=egolabs-dev-secret
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
# Sign-in with Google (see the root .env.example for how to make the OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Password sign-in for scripts only (make seed, scripts/smoke.sh); people sign in with Google.
PASSWORD_LOGIN=false
